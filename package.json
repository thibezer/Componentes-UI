{
  "name": "@thibezer/ui-components-kit",
  "version": "1.0.0",
  "description": "Web Components nativos (W3C Custom Elements + Shadow DOM) para interfaces densas de GIS, CAD e formulários, sem dependência de framework.",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "ui-kit",
    "design-system",
    "gis",
    "cad",
    "leaflet",
    "form-associated",
    "custom-elements-manifest",
    "react",
    "vue"
  ],
  "author": "thibezer",
  "license": "MIT",
  "homepage": "https://github.com/thibezer/Componentes-UI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thibezer/Componentes-UI.git"
  },
  "bugs": {
    "url": "https://github.com/thibezer/Componentes-UI/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/ui-kit.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./camadas": {
      "types": "./dist/camadas.d.ts",
      "import": "./dist/camadas.js",
      "require": "./dist/camadas.cjs"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js",
      "require": "./dist/forms.cjs"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.cjs"
    },
    "./tabela": {
      "types": "./dist/tabela.d.ts",
      "import": "./dist/tabela.js",
      "require": "./dist/tabela.cjs"
    },
    "./style.css": "./dist/ui-kit.css",
    "./ui-kit.css": "./dist/ui-kit.css",
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "require": "./dist/register.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js",
      "require": "./dist/data.cjs"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "require": "./dist/tools.cjs"
    },
    "./mapa": {
      "types": "./dist/mapa.d.ts",
      "import": "./dist/mapa.js",
      "require": "./dist/mapa.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js",
      "require": "./dist/canvas.cjs"
    },
    "./botao": {
      "types": "./dist/botao.d.ts",
      "import": "./dist/botao.js",
      "require": "./dist/botao.cjs"
    },
    "./campo-texto": {
      "types": "./dist/campo-texto.d.ts",
      "import": "./dist/campo-texto.js",
      "require": "./dist/campo-texto.cjs"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js",
      "require": "./dist/modal.cjs"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js",
      "require": "./dist/card.cjs"
    },
    "./seletor-mapa-base": {
      "types": "./dist/seletor-mapa-base.d.ts",
      "import": "./dist/seletor-mapa-base.js",
      "require": "./dist/seletor-mapa-base.cjs"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./tipos-react": {
      "types": "./dist/tipos-react.d.ts"
    },
    "./tipos-vue": {
      "types": "./dist/tipos-vue.d.ts"
    },
    "./tipos-elementos": {
      "types": "./dist/tipos-elementos.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run manifesto",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepublishOnly": "npm test && npm run build && npm run test:tipos",
    "manifesto": "cem analyze --config custom-elements-manifest.config.mjs",
    "test:tipos": "tsc -p tests/tipos/tsconfig.json"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "element-internals-polyfill": "^3.0.2",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.1",
    "leaflet": "^1.9.4",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "dist/custom-elements.json"
}
